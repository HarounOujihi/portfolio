# Postgres with pgvector available (Neon/Supabase/Prisma Postgres in prod; local: pgvector/pgvector Docker on 5434)
DATABASE_URL=
# LLM + embeddings (server-side only, never referenced in Client Components)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Auth (Phase 4)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# comma-separated admin allow-list (lowercase)
ADMIN_EMAILS=
BETTER_AUTH_URL=              # set per environment (used by Better Auth)
# Rate limiting (Phase 2/5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashing visitor identifiers (Phase 5) — generate with: openssl rand -hex 32
VISITOR_HASH_SALT=
